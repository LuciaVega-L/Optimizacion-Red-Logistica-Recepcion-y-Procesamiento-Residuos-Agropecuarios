flowchart TB
  U["«actor»<br/>Usuario"]
  FE["<b>Cliente: navegador web</b><br/>Interfaz React + Vite<br/>(Parametrización, Modelo exacto, Algoritmo genético,<br/>Sensibilidad, Comparativo, Historial)"]
  RT["<b>Servidor: API REST (FastAPI, Python)</b><br/>Rutas /red, /exacto, /genetico, /sensibilidad,<br/>/comparativo, /escenarios, /resultados"]

  subgraph SVC["Servicios del backend"]
    direction LR
    S1["red<br/>(carga, validación,<br/>balanceo)"]
    S2["exacto<br/>(modelo PL,<br/>duales)"]
    S3["genetico<br/>(algoritmo<br/>genético)"]
    S4["sensibilidad<br/>(rangos,<br/>escenarios)"]
    S5["comparativo<br/>(gap,<br/>escalabilidad)"]
  end

  JS[("Archivos JSON<br/>(escenarios)")]
  DB[("PostgreSQL<br/>(Supabase)")]
  CBC[("Solver CBC<br/>(PuLP)")]

  U --> FE
  FE -- "HTTP / JSON" --> RT
  RT --> S1
  RT --> S2
  RT --> S3
  RT --> S4
  RT --> S5
  S1 --> JS
  S1 -- "SQLAlchemy" --> DB
  S2 --> CBC
