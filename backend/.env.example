APP_NOMBRE=EcoResiduos API

# --- CORS: páginas a las que el navegador deja leer las respuestas de la API ---
# Lista separada por comas (p. ej. agreguen aquí la URL donde publiquen el frontend).
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173
# true: además acepta localhost / 127.0.0.1 en cualquier puerto (desarrollo).
# Pónganlo en false si publican la API y solo quieren los orígenes de la lista.
CORS_LOCALHOST=true

# --- Base de datos ---
# json -> lee backend/data/escenarios/*.json (sin base de datos)
# bd   -> PostgreSQL de Supabase con SQLAlchemy
FUENTE_DATOS=json
# Supabase > botón "Connect" > "Session pooler" (copiar la URI completa)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres
# Contraseña de la base de datos (la que pusieron al crear el proyecto).
# Va aquí y NO dentro de DATABASE_URL: así no hay que codificar caracteres especiales.
# Solo en backend/.env; nunca en .env.example ni en GitHub.
DATABASE_PASSWORD=
